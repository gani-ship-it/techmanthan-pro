rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Competitions collection:
    // Anyone can read active competition listings
    // Only authenticated admin can create or update competition status
    match /competitions/{compId} {
      allow read: if true;
      allow write: if request.auth != null || resource == null; // Restrict client write in production

      // Subcollection: Participants
      match /participants/{rollNo} {
        allow read: if true;
        // Allow creation of new participant or update of existing participant.
        // If updating an existing participant, block reverting 'hasParticipated' to false, 
        // or reverting a completed/disqualified status back to pending, unless auth'd as admin.
        allow create: if true;
        allow update: if true 
                      && (request.auth != null || 
                          (resource.data.hasParticipated == false || request.resource.data.hasParticipated == true) &&
                          (resource.data.status == 'Pending' || request.resource.data.status == resource.data.status));
        allow delete: if request.auth != null;
      }
    }
  }
}
